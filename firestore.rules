rules_version = '2';

// The website and the admin module talk to Firestore exclusively through the
// Firebase Admin SDK on the server, which bypasses these rules. Lock the
// database down so nothing can read or write it from a browser directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
