# ── Contact forms (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
# Where website inquiries are delivered. Required, or the forms will not send.
CONTACT_TO_EMAIL=sales@buttbricks.com
# Sender address. MUST be on a domain verified in Resend, otherwise Resend
# only delivers to the Resend account owner's own inbox.
CONTACT_FROM_EMAIL=website@buttbricks.com

# ── Firebase (Admin SDK, server-side only) ─────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the quotes; "\n" sequences are converted to real newlines at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Firebase console → Project settings → General → Web API Key (used for admin sign-in)
FIREBASE_WEB_API_KEY=AIza...
# Optional: comma-separated list of emails allowed into /admin. Empty = any Firebase Auth user.
ADMIN_EMAILS=owner@example.com

# ── Cloudinary (product imagery) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret
# Optional: root folder for uploads (default: buttbricks)
CLOUDINARY_UPLOAD_FOLDER=buttbricks

# Public site URL, used for canonical/social metadata (defaults to https://buttbricks.com)
NEXT_PUBLIC_SITE_URL=https://buttbricks.com
